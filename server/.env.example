# Copy this file to .env and fill it in. Never commit .env.
ANTHROPIC_API_KEY=
# Postgres connection string (free at neon.com). Leave empty to save signups to a local file.
DATABASE_URL=
# Any long random text. Lets you download the launch list and AI answer reports: /api/admin/waitlist.csv?key=THIS
ADMIN_KEY=
# Most AI calls allowed per day across everyone
DAILY_AI_LIMIT=1000
# Optional model overrides
AI_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-4-5-20251001
